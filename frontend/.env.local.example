# Supabase — used server-side only by app/api/submit/route.ts.
# NOT prefixed with NEXT_PUBLIC, so these never reach the browser.
# Project URL: Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# service_role key (secret!): Project Settings → API → service_role. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: interview-slot booking link shown on the thank-you page.
# If unset, the thank-you page shows the reminder text without a button.
NEXT_PUBLIC_INTERVIEW_BOOKING_URL=

