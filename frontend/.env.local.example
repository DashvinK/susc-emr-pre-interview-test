# Supabase — used server-side only by app/api/submit/route.ts.
# NOT prefixed with NEXT_PUBLIC, so these never reach the browser.
# Project URL: Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# service_role key (secret!): Project Settings → API → service_role. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
